# Local development: copy this file to server/.env and fill it in.
# On Vercel, add the same names under Project Settings > Environment Variables instead.

PORT=3001

# Shown in the site header and browser tab.
EVENT_TITLE=DSWD Academy Gawad Linang

# REQUIRED. The Web app URL from Apps Script (Deploy > Manage deployments). It ends in /exec.
# Without it, voting is switched off: the site will not pretend to save votes.
APPS_SCRIPT_URL=https://script.google.com/macros/s/AKfycbyccxA3CYD-PsjGQWbKSo5j2l7v8lhbGdHFRXUlE6sqOTxgTE2k4jJjB1aDI1f5ESKF/exec

# Must match the SECRET script property in Apps Script. Strongly recommended.
# If you leave SECRET unset in Apps Script, leave this empty too.
APPS_SCRIPT_TOKEN=my_super_secret_token_123

# Optional: only accept these email domains, comma separated (e.g. example.gov.ph,example.com).
# Leave empty to accept any email address.
ALLOWED_EMAIL_DOMAINS=

# Optional, for trying the design on your own computer WITHOUT Google Sheets.
# Votes are then saved to a local file only and never reach the sheet. Ignored on Vercel.
# LOCAL_ONLY=true
